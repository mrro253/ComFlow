FROM golang:1.27.3-bookworm@sha256:dc0963f32053e4bc451d24d87e3892d42d01021b61f093e98eb95c0352bb84b0 AS build
WORKDIR /src
ENV GOTOOLCHAIN=local
COPY gateway/go.mod ./
COPY gateway/*.go ./
# Standard-library-only build and tests require no network or external modules.
RUN --network=none go test -race -count=1 ./... \
    && go vet ./... \
    && CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/gateway .

FROM gcr.io/distroless/static-debian13:nonroot@sha256:25ac8f0c3b2334a9eb05452266bd4697864a8c8ef0ef71e5e6480d7f92868329
COPY --from=build /out/gateway /gateway
COPY --from=build /usr/local/go/LICENSE /licenses/Go-LICENSE
# No shell, package manager, dynamic libc, admin API or privileged bind capability.
USER 1001:1001
ENTRYPOINT ["/gateway"]
