{
    admin off
    persist_config off
    auto_https off
}
https://localhost:8443 {
    tls /state/rehearsal/tls.crt /state/rehearsal/tls.key
    @verification {
        path /verification
        method POST
    }
    handle @verification {
        request_body {
            max_size 2KB
        }
        reverse_proxy 127.0.0.1:8080
    }
    handle {
        respond "Unavailable" 404
    }
}
