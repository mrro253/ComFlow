# Copy this file to .env.local and fill in values from `supabase status`
# (after running `supabase start`) for local development, or from your
# hosted Supabase project's Settings > API page once you're ready to publish.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_ - used solely by
# lib/supabase/admin.ts to create teammate accounts from Settings.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. 32 random bytes, base64 - encrypts carrier portal logins that
# agents enter in the app (AES-256-GCM). Generate with: openssl rand -base64 32
# The carrier worker (worker/) needs the SAME value to decrypt them.
# Losing or changing this key makes saved carrier logins unreadable (agents re-enter them).
CREDENTIAL_ENCRYPTION_KEY=
